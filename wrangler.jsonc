{
  // PREVIEW of BodyArcade v2: the release build (dist/, made by release/build.ts) plus the one Worker
  // (packages/server: live play rooms, invites, TURN credentials, social, the old game addresses, CSP reports).
  // This is the repository's default config on purpose: a bare `npx wrangler deploy` can only ever reach the
  // preview, never bodyarcade.com. Production is wrangler.prod.jsonc, switched by the main session after the
  // final test (node release/deploy.ts production --confirm-production).
  //   node release/deploy.ts preview          build, check, deploy (secrets from the local secrets file)
  //   https://bodyarcade-v2-preview.railer-iot.workers.dev
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bodyarcade-v2-preview",
  "main": "packages/server/src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The API and the old game addresses (their query decides where they go: packages/server/src/site/routes.ts).
    "run_worker_first": ["/api/*", "/bodyarcade", "/bodyarcade/", "/BodyArcade", "/BodyArcade/", "/BodyArcade.html", "/bodyarcade.html", "/play", "/play/", "/app", "/app/", "/index.html"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "HUB", "class_name": "PlayerHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["PlayerHub"] }],
  // The social D1 database ("DB") is added once it exists: the wrangler login of this machine lacks the D1 scope
  // (24 Oct). Until then the social hooks do nothing and live play uses its anonymous identity.
  "vars": { "PUBLIC_ORIGIN": "https://bodyarcade-v2-preview.railer-iot.workers.dev", "SITE_TARGET": "preview" },
  "observability": { "enabled": true },
  "upload_source_maps": false
}
