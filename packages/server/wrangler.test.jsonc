{
  // The Worker as the live test suite runs it (tests/live): the test entry with /api/admin/*, a fixed test secret,
  // no per-IP limits, and no static assets (the suite serves its pages itself and proxies /api to this Worker).
  // Never deployed.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bodyarcade-live-test",
  "main": "src/testing.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "TICKET_SECRET": "test-only-ticket-secret-0123456789abcdef",
    "LIVE_NO_LIMITS": "1"
  }
}
