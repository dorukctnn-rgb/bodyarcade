{
  // BodyArcade v2 Worker: static assets (the web app) + /api/* + the Room Durable Object.
  // A separate Worker name on purpose: the live site is the Worker "bodyarcade" (main branch, cloudflare-hosting).
  // The release step renames this one, builds the web app into ../../dist and sets the secrets:
  //   npx wrangler secret put TICKET_SECRET          (32+ random characters)
  //   npx wrangler secret put TURN_KEY_ID            (Cloudflare Realtime TURN key)
  //   npx wrangler secret put TURN_KEY_API_TOKEN
  // Entitlements (who may use Pro; packages/server/src/entitlements):
  //   npx wrangler secret put ENT_PRIV_JWK           (ES256 private key as a JWK with a kid; node tools/entitlements/gen-keys.mjs makes one)
  //   npx wrangler secret put PLAY_SA_JSON           (Google Play service account JSON; without it Play purchases answer "unavailable")
  //   npx wrangler secret put ENT_MAIL_TOKEN         (ForwardEmail API token) and the variable ENT_MAIL_FROM: the trial reminder e-mail; optional
  // Optional variables: GUMROAD_PRODUCTS (JSON of Gumroad product id -> plan id), ENT_PUB_JWKS (older public keys during a key rotation).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bodyarcade-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/r/*", "/f/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "HUB", "class_name": "PlayerHub" }, { "name": "SOCIAL", "class_name": "SocialDirectory" }, { "name": "ENTITLEMENTS", "class_name": "EntitlementsDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["PlayerHub"] }, { "tag": "v3", "new_sqlite_classes": ["EntitlementsDO"] }, { "tag": "v4", "new_sqlite_classes": ["SocialDirectory"] }],
  // Social (profiles, friends, presence, lobbies, boards, moderation) is one Durable Object, SocialDirectory (binding SOCIAL,
  // migration v4): its SQLite storage holds every table and the players' sockets, so there is no database to create. HUB and
  // PlayerHub stay only because migration v2 made that class on the preview; nothing uses them. Optional secret: ADMIN_TOKEN
  // (the moderation API answers 404 without it); optional variable: SOCIAL_MAX_SIGNUPS_PER_DAY (default 4000).
  "vars": { "PUBLIC_ORIGIN": "https://bodyarcade.com" },
  "observability": { "enabled": true }
}
