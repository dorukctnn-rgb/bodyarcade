<?xml version="1.0" encoding="utf-8"?>
<!-- Shown only when the app is opened for the first time with no connection (LauncherActivity).
     The outer box keeps fitsSystemWindows: the system bars and the display cutout (in portrait and in landscape, on either side) become ITS padding.
     fitsSystemWindows REPLACES the padding of the view that carries it, so the 28 dp side margin lives on the inner box, which has no such flag:
     the text always sits at least 28 dp inside the area the system leaves free. The scroll view keeps the button reachable on short (landscape) screens. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/offline_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/offline_title"
                android:textColor="#F4F1FF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/offline_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/offline_body"
                android:textColor="#CFC8EA"
                android:textSize="17sp" />

            <Button
                android:id="@+id/offline_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/offline_button"
                android:minWidth="160dp"
                android:minHeight="52dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/offline_retry"
                android:textAllCaps="false"
                android:textColor="#1A1430"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
