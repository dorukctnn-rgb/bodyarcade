{
  "name": "bodyarcade",
  "version": "2.0.0-dev",
  "private": true,
  "description": "BodyArcade v2: webcam fitness games in the browser (platform, games, web). The live site stays in site/.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1"
  }
}
